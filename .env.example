# Copy this file to `.env.local` and fill in your connection string.

# The only required variable. Any PostgreSQL 14+ database works.
#
# Local Postgres example:
#   DATABASE_URL="postgres://postgres:postgres@localhost:5432/fleetcare"
#
# Local Postgres in Docker:
#   docker run --name fleetcare-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=fleetcare -p 5432:5432 -d postgres:16
#   DATABASE_URL="postgres://postgres:postgres@localhost:5432/fleetcare"
#
# Neon / hosted example:
#   DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL="postgres://postgres:root@localhost:5432/fleetcare"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
NEXT_PUBLIC_MAPBOX_TOKEN=