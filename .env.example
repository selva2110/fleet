# Copy this file to `.env.local`. The frontend is a pure API client — it
# talks to these backend services (be/vehicle-service, be/participant-service,
# be/driver-service, be/event-notification, be/trip-service), never to
# Postgres or Twilio directly. See each service's own .env.example for how
# to run them (they share one Postgres database, "fleetcare").
# VEHICLE_SERVICE_URL=http://localhost:8081
# PARTICIPANT_SERVICE_URL=http://localhost:8082
# DRIVER_SERVICE_URL=http://localhost:8080
# DRIVER_SERVICE_JWT_SECRET=
# EVENT_SERVICE_URL=http://localhost:8090
# TRIP_SERVICE_URL=http://localhost:8083

NEXT_PUBLIC_MAPBOX_TOKEN=

DRIVER_SERVICE_JWT_SECRET=dev-secret-change-me
VEHICLE_SERVICE_URL=https://dev-tranzio-vehicle.cdians.com
PARTICIPANT_SERVICE_URL=https://dev-tranzio-event.cdians.com
DRIVER_SERVICE_URL=https://dev-tranzio-driver.cdians.com
# Must match be/driver-service/.env's JWT_SECRET.
DRIVER_SERVICE_JWT_SECRET=
EVENT_SERVICE_URL=https://dev-tranzio-event.cdians.com
TRIP_SERVICE_URL=https://dev-tranzio-trip.cdians.com
AUTH_SERVICE_URL=https://dev-carevoy-auth.cdians.com
CATALOG_SERVICE_URL=https://dev-carevoy-catalog.cdians.com